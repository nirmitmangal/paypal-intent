# =================================================================
# PayPal Intent Environment Configuration
# =================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
LOG_LEVEL=info

# Database Configuration (SQLite)
DATABASE_PATH=./data/paypal_intent.db

# AI Inference (Ollama - Local Open Weights)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# PayPal Sandbox Integration
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=sandbox_client_id_placeholder
PAYPAL_CLIENT_SECRET=sandbox_client_secret_placeholder

# Security & Session
SESSION_SECRET=dev_session_secret_paypal_intent_2026
